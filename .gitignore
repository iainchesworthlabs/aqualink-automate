# .gitignore for Aqualink Automate (C++23 / CMake / vcpkg, with Node + MkDocs tooling)
# Keep this file lean and project-relevant. Group by concern; comment non-obvious rules.

# ── Build output ────────────────────────────────────────────────────────────
# CMake configures into build/ (see CMakePresets.json); out/ is the VS/CMake
# default. Both are disposable and regenerated.
/build/
/out/
[Bb]uild/
[Dd]ebug/
[Rr]elease/

# ── CMake local/user files (per-developer; never shared) ────────────────────
CMakeUserPresets.json
CMakeSettings.json
CMakeCache.txt
CMakeFiles/

# ── vcpkg (dependencies are restored from vcpkg.json; the submodule lives in
#    deps/vcpkg and stays tracked, but its installed tree does not) ───────────
[Vv]cpkg_installed/

# ── Compiled objects / binaries / debug info ────────────────────────────────
*.o
*.obj
*.a
*.lib
*.so
*.so.*
*.dylib
*.dll
*.exe
*.pdb
*.ilk
*.exp
*.pch
*.gcda
*.gcno

# ── Static analysis / coverage working dirs ─────────────────────────────────
# SonarCloud scanner + build-wrapper output.
.scannerwork/
[Bb]uild_wrapper_output_directory/
*.coverage
*.coveragexml

# ── Node tooling: Playwright e2e + MkDocs screenshot capture ────────────────
node_modules/
test-results/
[Tt]est[Rr]esults/
playwright-report/
playwright/.cache/
blob-report/

# ── MkDocs build output (published to gh-pages by docs.yml) ──────────────────
/site/

# ── Python (seed-corpus / helper scripts) ───────────────────────────────────
__pycache__/
*.pyc

# ── Packer (never commit variable values — may contain secrets/infra) ────────
cicd/packer/*.pkrvars.hcl
!cicd/packer/*.pkrvars.hcl.example
cicd/packer/ISOs/
cicd/packer/packer_cache/

# ── Runtime artifacts the app writes locally (not source) ────────────────────
# Emulated-EEPROM persistence written at runtime.
EEPROM.DAT
# Serial capture / replay scratch (recordings + decode logs; large, never source).
captures/
# Assorted run logs (decode.log, integration.log, etc.).
*.log

# ── IDE / editor working dirs (per-developer; never shared) ──────────────────
.idea/
.vscode/
.vs/
*.user
*.suo

# ── Claude Code machine-local settings (permissions/paths specific to one
#    machine). Shared .claude/skills/** and team-wide settings.json stay tracked.
.claude/settings.local.json
.claude/worktrees/

# ── OS cruft ────────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
*~
